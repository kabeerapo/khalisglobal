<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Khalis Typing Center | Trusted Business Partner in UAE</title>
  <meta name="description" content="Khalis Typing Center in Abu Dhabi - Professional PRO services, typing, business setup, document attestation, Emirates ID, visa processing and more. Your trusted partner for seamless documentation and solutions.">
  <link rel="icon" href="logo.png" type="image/png">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            khalis: {
              red: '#B91C2C',
              green: '#0D7A4F',
              dark: '#0A1210',
              ink: '#12201A',
              cream: '#F6F1E8',
              sand: '#EDE6D9',
              gold: '#C4A35A',
              muted: '#5C6B62'
            }
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
            display: ['Cormorant Garamond', 'Georgia', 'serif']
          },
          boxShadow: {
            soft: '0 10px 40px -12px rgba(10, 18, 16, 0.12)',
            lift: '0 24px 48px -16px rgba(13, 122, 79, 0.28)',
            glow: '0 0 0 1px rgba(13, 122, 79, 0.15), 0 20px 50px -20px rgba(13, 122, 79, 0.35)'
          },
          animation: {
            'float': 'float 6s ease-in-out infinite',
            'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'slide-up': 'slideUp 0.8s ease-out forwards',
            'fade-in': 'fadeIn 1s ease-out forwards',
            'scale-in': 'scaleIn 0.6s ease-out forwards',
            'gradient': 'gradient 8s ease infinite'
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0)' },
              '50%': { transform: 'translateY(-20px)' }
            },
            slideUp: {
              '0%': { opacity: '0', transform: 'translateY(40px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' }
            },
            fadeIn: {
              '0%': { opacity: '0' },
              '100%': { opacity: '1' }
            },
            scaleIn: {
              '0%': { opacity: '0', transform: 'scale(0.9)' },
              '100%': { opacity: '1', transform: 'scale(1)' }
            },
            gradient: {
              '0%, 100%': { backgroundPosition: '0% 50%' },
              '50%': { backgroundPosition: '100% 50%' }
            }
          }
        }
      }
    }
  </script>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- AOS Animations -->
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  
  <!-- Lottie Player -->
  <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
  
  <style>
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background: #F6F1E8;
      color: #12201A;
      -webkit-font-smoothing: antialiased;
    }
    .font-display {
      font-family: 'Cormorant Garamond', Georgia, serif;
      letter-spacing: -0.02em;
      font-weight: 600;
    }
    ::selection {
      background: rgba(13, 122, 79, 0.2);
      color: #0A1210;
    }

    .video-frame {
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      border-radius: 1.25rem;
      background: #0A1210;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
    }
    .video-frame iframe {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      border: 0;
    }

    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: #EDE6D9; }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, #0D7A4F, #0A1210);
      border-radius: 999px;
      border: 2px solid #EDE6D9;
    }

    .hero-gradient {
      background:
        radial-gradient(ellipse 80% 60% at 20% 20%, rgba(13,122,79,0.35), transparent 55%),
        radial-gradient(ellipse 70% 50% at 85% 15%, rgba(185,28,44,0.22), transparent 50%),
        radial-gradient(ellipse 60% 40% at 70% 90%, rgba(196,163,90,0.12), transparent 45%),
        linear-gradient(165deg, #070d0b 0%, #0f1f18 45%, #0A1210 100%);
    }

    .glass {
      background: rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(20px) saturate(1.2);
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 20px 50px -24px rgba(0,0,0,0.5);
    }

    .service-card {
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 0.35s ease,
                  border-color 0.35s ease;
      border: 1px solid rgba(18, 32, 26, 0.08);
      background: #FFFcf7;
    }
    .service-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 28px 50px -20px rgba(13, 122, 79, 0.22);
      border-color: rgba(13, 122, 79, 0.25);
    }

    .nav-link {
      position: relative;
      transition: color 0.2s ease;
    }
    .nav-link::after {
      content: '';
      position: absolute;
      width: 0;
      height: 2px;
      bottom: -5px;
      left: 0;
      background: linear-gradient(90deg, #B91C2C, #0D7A4F);
      border-radius: 2px;
      transition: width 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .nav-link:hover::after { width: 100%; }

    .floating-shape {
      position: absolute;
      border-radius: 50%;
      filter: blur(70px);
      opacity: 0.45;
      animation: float 10s ease-in-out infinite;
    }

    .pulse-ring {
      position: absolute;
      border-radius: 50%;
      border: 1.5px solid rgba(13, 122, 79, 0.35);
      animation: pulse-ring 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.85); opacity: 0.9; }
      100% { transform: scale(1.7); opacity: 0; }
    }

    .animated-bg {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }
    .animated-bg::before {
      content: '';
      position: absolute;
      width: 180%;
      height: 180%;
      top: -40%;
      left: -40%;
      background:
        radial-gradient(circle at 25% 35%, rgba(13,122,79,0.18) 0%, transparent 42%),
        radial-gradient(circle at 75% 65%, rgba(185,28,44,0.12) 0%, transparent 38%),
        radial-gradient(circle at 55% 15%, rgba(196,163,90,0.1) 0%, transparent 40%);
      animation: rotate-bg 32s linear infinite;
    }
    @keyframes rotate-bg {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .star-filled { color: #C4A35A; }

    .mobile-menu {
      transition: max-height 0.4s ease, opacity 0.3s ease;
    }

    .form-input {
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    .form-input:focus {
      box-shadow: 0 0 0 3px rgba(13, 122, 79, 0.25);
      border-color: #0D7A4F !important;
    }

    .spinner {
      border: 3px solid rgba(255,255,255,0.25);
      border-top-color: white;
      border-radius: 50%;
      width: 20px;
      height: 20px;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .btn-primary {
      background: linear-gradient(135deg, #0D7A4F 0%, #0A5C3B 100%);
      box-shadow: 0 12px 28px -10px rgba(13, 122, 79, 0.55);
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
    }
    .btn-primary:hover {
      filter: brightness(1.08);
      box-shadow: 0 16px 36px -10px rgba(13, 122, 79, 0.65);
      transform: translateY(-1px);
    }
    .btn-primary:active { transform: scale(0.97); }

    .section-eyebrow {
      letter-spacing: 0.2em;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .card-shine {
      position: relative;
      overflow: hidden;
    }
    .card-shine::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.08) 50%, transparent 70%);
      transform: translateX(-120%);
      transition: transform 0.7s ease;
      pointer-events: none;
    }
    .card-shine:hover::after { transform: translateX(120%); }

    #navbar.nav-solid {
      background: rgba(10, 18, 16, 0.92) !important;
      backdrop-filter: blur(16px);
      box-shadow: 0 10px 40px -20px rgba(0,0,0,0.5);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    @media (prefers-reduced-motion: reduce) {
      .floating-shape, .animated-bg::before, .pulse-ring, .hero-gradient {
        animation: none !important;
      }
    }
  </style>
</head>
<body class="bg-khalis-cream text-khalis-ink overflow-x-hidden">

  <!-- ========== NAVBAR ========== -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Logo -->
        <a href="#home" class="flex items-center gap-3 group">
          <img src="logo.png" alt="Khalis Logo" class="h-12 w-auto transition-transform duration-300 group-hover:scale-105">
          <div class="hidden sm:block">
            <span class="font-display font-bold text-lg text-white tracking-tight">KHALIS</span>
            <span class="block text-xs text-green-400 font-medium -mt-1">TYPING CENTER</span>
          </div>
        </a>
        
        <!-- Desktop Nav -->
        <div class="hidden lg:flex items-center gap-8">
          <a href="#home" class="nav-link text-white/90 hover:text-white text-sm font-medium">Home</a>
          <a href="#services" class="nav-link text-white/90 hover:text-white text-sm font-medium">Services</a>
          <a href="#gov" class="nav-link text-white/90 hover:text-white text-sm font-medium">Gov Services</a>
          <a href="#uae-videos" class="nav-link text-white/90 hover:text-white text-sm font-medium">UAE Videos</a>
