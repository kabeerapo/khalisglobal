          <a href="#about" class="nav-link text-white/90 hover:text-white text-sm font-medium">About</a>
          <a href="#reviews" class="nav-link text-white/90 hover:text-white text-sm font-medium">Reviews</a>
          <a href="#contact" class="nav-link text-white/90 hover:text-white text-sm font-medium">Contact</a>
        </div>
        
        <!-- CTA + Mobile Toggle -->
        <div class="flex items-center gap-4">
          <a href="tel:+971501201818" class="btn-primary hidden sm:flex items-center gap-2 text-white px-5 py-2.5 rounded-full text-sm font-semibold">
            <i class="fas fa-phone-alt text-xs"></i>
            050 120 1818
          </a>
          <button id="menuBtn" class="lg:hidden text-white p-2" aria-label="Toggle menu">
            <i class="fas fa-bars text-xl"></i>
          </button>
        </div>
      </div>
      
      <!-- Mobile Menu -->
      <div id="mobileMenu" class="lg:hidden mobile-menu max-h-0 opacity-0 overflow-hidden">
        <div class="py-4 space-y-3 border-t border-white/10">
          <a href="#home" class="block text-white/90 hover:text-white py-2 text-sm font-medium">Home</a>
          <a href="#services" class="block text-white/90 hover:text-white py-2 text-sm font-medium">Services</a>
          <a href="#gov" class="block text-white/90 hover:text-white py-2 text-sm font-medium">Gov Services</a>
          <a href="#uae-videos" class="block text-white/90 hover:text-white py-2 text-sm font-medium">UAE Videos</a>
          <a href="#process" class="block text-white/90 hover:text-white py-2 text-sm font-medium">How It Works</a>
          <a href="#about" class="block text-white/90 hover:text-white py-2 text-sm font-medium">About</a>
          <a href="#reviews" class="block text-white/90 hover:text-white py-2 text-sm font-medium">Reviews</a>
          <a href="#contact" class="block text-white/90 hover:text-white py-2 text-sm font-medium">Contact</a>
          <a href="tel:+971501201818" class="flex items-center gap-2 bg-khalis-green text-white px-5 py-3 rounded-full text-sm font-semibold w-fit mt-2">
            <i class="fas fa-phone-alt text-xs"></i>
            Call Now
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- ========== HERO SECTION ========== -->
  <section id="home" class="relative min-h-screen flex items-center hero-gradient overflow-hidden">
    <!-- Animated background layers -->
    <div class="animated-bg"></div>
    
    <!-- Floating shapes -->
    <div class="floating-shape w-96 h-96 bg-khalis-green top-20 -left-20"></div>
    <div class="floating-shape w-80 h-80 bg-khalis-red bottom-10 right-10" style="animation-delay: -3s;"></div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left content -->
        <div class="text-center lg:text-left" data-aos="fade-right" data-aos-duration="1000">
          <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-1.5 mb-6">
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
            <span class="text-green-300 text-sm font-medium">Trusted in Abu Dhabi • 4.9★ (858+ Reviews)</span>
          </div>
          
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
            Your Trusted<br>
            <span class="bg-gradient-to-r from-green-400 via-emerald-300 to-green-400 bg-clip-text text-transparent">Business Partner</span><br>
            in the UAE
          </h1>
          
          <p class="text-lg text-slate-300 mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed">
            From typing & documentation to PRO services, business setup, visa processing and professional licensing — we handle it all with speed, accuracy and care.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a href="#contact" class="btn-primary inline-flex items-center justify-center gap-2 text-white px-8 py-4 rounded-full font-semibold text-base">
              <i class="fas fa-rocket"></i>
              Get Free Consultation
            </a>
            <a href="#services" class="inline-flex items-center justify-center gap-2 bg-white/8 hover:bg-white/15 text-white px-8 py-4 rounded-full font-semibold text-base transition-all duration-300 border border-white/25 backdrop-blur-sm">
              <i class="fas fa-th-large"></i>
              Explore Services
            </a>
          </div>
          
          <!-- Trust badges -->
          <div class="mt-10 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-slate-400 text-sm">
            <div class="flex items-center gap-2">
              <i class="fas fa-check-circle text-green-400"></i>
              <span>Fast Turnaround</span>
            </div>
            <div class="flex items-center gap-2">
              <i class="fas fa-check-circle text-green-400"></i>
              <span>Expert PRO Team</span>
            </div>
            <div class="flex items-center gap-2">
              <i class="fas fa-check-circle text-green-400"></i>
              <span>Government Approved</span>
            </div>
          </div>
        </div>
        
        <!-- Right visual -->
        <div class="relative hidden lg:flex justify-center" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="200">
          <div class="relative">
            <!-- Glow rings -->
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="pulse-ring w-80 h-80"></div>
              <div class="pulse-ring w-80 h-80" style="animation-delay: 0.7s;"></div>
            </div>
            
            <!-- Main Lottie + Logo card -->
            <div class="relative glass rounded-3xl p-6 shadow-2xl overflow-hidden">
              <!-- Lottie Animation (Business Success / Documents) -->
              <lottie-player
                src="https://assets5.lottiefiles.com/packages/lf20_V9t630.json"
                background="transparent"
                speed="1"
                style="width: 280px; height: 220px; margin: 0 auto;"
                loop
                autoplay>
              </lottie-player>
              
              <div class="text-center -mt-4 pb-2">
                <img src="logo.png" alt="Khalis Typing Center" class="w-28 h-auto mx-auto drop-shadow-xl mb-2">
                <p class="text-white font-display font-bold text-lg">KHALIS</p>
                <p class="text-green-400 text-xs tracking-widest">SERVICES • DOCUMENTATION • SOLUTIONS</p>
              </div>
            </div>
            
            <!-- Floating mini cards -->
            <div class="absolute -top-6 -left-10 glass rounded-2xl px-4 py-3 shadow-xl animate-float" style="animation-delay: -2s;">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-green-500/20 rounded-lg flex items-center justify-center">
                  <i class="fas fa-file-alt text-green-400 text-sm"></i>
                </div>
                <div>
                  <p class="text-white text-xs font-semibold">Typing & Docs</p>
                  <p class="text-slate-400 text-[10px]">Same-day service</p>
                </div>
              </div>
            </div>
            
            <div class="absolute -bottom-4 -right-8 glass rounded-2xl px-4 py-3 shadow-xl animate-float" style="animation-delay: -4s;">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-red-500/20 rounded-lg flex items-center justify-center">
                  <i class="fas fa-briefcase text-red-400 text-sm"></i>
                </div>
                <div>
                  <p class="text-white text-xs font-semibold">Business Setup</p>
                  <p class="text-slate-400 text-[10px]">End-to-end support</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/50 animate-bounce">
      <i class="fas fa-chevron-down text-xl"></i>
    </div>
  </section>

  <!-- ========== SERVICES SECTION ========== -->
  <section id="services" class="py-24 bg-khalis-cream relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16" data-aos="fade-up">
        <span class="section-eyebrow inline-block text-khalis-green mb-3">What We Offer</span>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-khalis-ink mb-4">
          Complete Solutions for<br>
          <span class="text-khalis-green">Your Business & Documents</span>
        </h2>
        <p class="text-khalis-muted max-w-2xl mx-auto text-lg leading-relaxed">
          From government paperwork to professional licensing and business formation — Khalis handles every step so you can focus on growth.
        </p>
      </div>
      
      <!-- Featured Services Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <!-- Service 1 -->
        <div class="service-card card-shine rounded-3xl p-6" data-aos="fade-up" data-aos-delay="0">
          <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-700 rounded-2xl flex items-center justify-center mb-5 shadow-lg shadow-blue-500/25">
            <i class="fas fa-certificate text-white text-xl"></i>
          </div>
          <h3 class="font-display font-bold text-xl text-khalis-ink mb-2">Equivalency Certificate</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            UAE Ministry of Education Equivalency Certificate for foreign degrees. Document attestation to application submission.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="text-xs bg-blue-50 text-blue-700 px-2.5 py-1 rounded-full">Data flow</span>
            <span class="text-xs bg-blue-50 text-blue-700 px-2.5 py-1 rounded-full">Golden visa</span>
          </div>
        </div>
        
        <!-- Service 2 -->
        <div class="service-card card-shine rounded-3xl p-6" data-aos="fade-up" data-aos-delay="100">
          <div class="w-14 h-14 bg-gradient-to-br from-slate-600 to-slate-800 rounded-2xl flex items-center justify-center mb-5 shadow-lg shadow-slate-600/25">
            <i class="fas fa-file-signature text-white text-xl"></i>
          </div>
          <h3 class="font-display font-bold text-xl text-khalis-ink mb-2">Will Registration UAE</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Secure your future with professional Will Registration — personal, property, financial or guardianship wills.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="text-xs bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full">Family Protection</span>
            <span class="text-xs bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full">Estate Planning</span>
          </div>
        </div>
        
        <!-- Service 3 -->
        <div class="service-card card-shine rounded-3xl p-6" data-aos="fade-up" data-aos-delay="200">
          <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-800 rounded-2xl flex items-center justify-center mb-5 shadow-lg shadow-emerald-600/25">
            <i class="fas fa-user-md text-white text-xl"></i>
          </div>
          <h3 class="font-display font-bold text-xl text-khalis-ink mb-2">DOH Professional Licensing</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Department of Health Abu Dhabi licensing for medicine, dentistry, nursing, pharmacy & allied health professionals.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="text-xs bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-full">DHA</span>
            <span class="text-xs bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-full">Specialists</span>
          </div>
        </div>
        
        <!-- Service 4 -->
        <div class="service-card card-shine rounded-3xl p-6" data-aos="fade-up" data-aos-delay="300">
          <div class="w-14 h-14 bg-gradient-to-br from-cyan-500 to-teal-700 rounded-2xl flex items-center justify-center mb-5 shadow-lg shadow-cyan-500/25">
            <i class="fas fa-handshake text-white text-xl"></i>
          </div>
          <h3 class="font-display font-bold text-xl text-khalis-ink mb-2">PRO Services</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Affordable, reliable PRO in Abu Dhabi — visa processing, trade license, Emirates ID, document clearing & more.
